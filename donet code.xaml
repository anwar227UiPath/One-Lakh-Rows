    <ui:InvokeCode ContinueOnError="{x:Null}" Code="Try&#xA;    ' 1. Open the file instantly in memory&#xA;    Using workbook As New ClosedXML.Excel.XLWorkbook(in_FilePath)&#xA;        &#xA;        ' 2. Target the first worksheet&#xA;        Dim worksheet As ClosedXML.Excel.IXLWorksheet = workbook.Worksheet(1)&#xA;        &#xA;        ' 3. Get the total count of used rows directly&#xA;        out_RowCount = worksheet.RowsUsed().Count()&#xA;        &#xA;    End Using&#xA;Catch ex As System.Exception&#xA;    Throw New System.Exception(&quot;Failed to get row count: &quot; &amp; ex.Message)&#xA;End Try" DisplayName="Invoke Code" sap:VirtualizedContainerService.HintSize="484.8,400.8" sap2010:WorkflowViewState.IdRef="InvokeCode_3">
