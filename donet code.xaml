          <ui:InvokeCode ContinueOnError="{x:Null}" Code="using System;&#xA;using System.Collections.Generic;&#xA;using System.Diagnostics;&#xA;using ClosedXML.Excel;&#xA;&#xA;try&#xA;{&#xA;    //==========================&#xA;    // Start Performance Timer&#xA;    //==========================&#xA;    Stopwatch sw = Stopwatch.StartNew();&#xA;&#xA;    //==========================&#xA;    // Variables&#xA;    //==========================&#xA;    int totalEmployees = 0;&#xA;    int highSalaryCount = 0;&#xA;    int missingEmailCount = 0;&#xA;    int duplicateMobileCount = 0;&#xA;&#xA;    double highestSalary = 0;&#xA;    double lowestSalary = double.MaxValue;&#xA;    double totalSalary = 0;&#xA;&#xA;    HashSet&lt;string&gt; mobileSet = new HashSet&lt;string&gt;();&#xA;&#xA;    Dictionary&lt;string, int&gt; countryCount = new Dictionary&lt;string, int&gt;();&#xA;&#xA;    //==========================&#xA;    // Open Excel&#xA;    //==========================&#xA;    using (var workbook = new XLWorkbook(in_FilePath))&#xA;    {&#xA;        var worksheet = workbook.Worksheet(1);&#xA;&#xA;        foreach (var row in worksheet.RowsUsed())&#xA;        {&#xA;            // Skip Header&#xA;            if (row.RowNumber() == 1)&#xA;                continue;&#xA;&#xA;            totalEmployees++;&#xA;&#xA;            //--------------------------------------------------&#xA;            // Read Cell Values&#xA;            //--------------------------------------------------&#xA;&#xA;            double salary = 0;&#xA;&#xA;            Double.TryParse(row.Cell(3).GetString(), out salary);&#xA;&#xA;            string mobile = row.Cell(5).GetString().Trim();&#xA;&#xA;            string country = row.Cell(6).GetString().Trim();&#xA;&#xA;            string email = row.Cell(7).GetString().Trim();&#xA;&#xA;            //--------------------------------------------------&#xA;            // Salary &gt; 100000&#xA;            //--------------------------------------------------&#xA;&#xA;            if (salary &gt; 100000)&#xA;                highSalaryCount++;&#xA;&#xA;            //--------------------------------------------------&#xA;            // Highest Salary&#xA;            //--------------------------------------------------&#xA;&#xA;            if (salary &gt; highestSalary)&#xA;                highestSalary = salary;&#xA;&#xA;            //--------------------------------------------------&#xA;            // Lowest Salary&#xA;            //--------------------------------------------------&#xA;&#xA;            if (salary &lt; lowestSalary)&#xA;                lowestSalary = salary;&#xA;&#xA;            //--------------------------------------------------&#xA;            // Total Salary&#xA;            //--------------------------------------------------&#xA;&#xA;            totalSalary += salary;&#xA;&#xA;            //--------------------------------------------------&#xA;            // Duplicate Mobile&#xA;            //--------------------------------------------------&#xA;&#xA;            if (!string.IsNullOrEmpty(mobile))&#xA;            {&#xA;                if (!mobileSet.Add(mobile))&#xA;                    duplicateMobileCount++;&#xA;            }&#xA;&#xA;            //--------------------------------------------------&#xA;            // Missing Email&#xA;            //--------------------------------------------------&#xA;&#xA;            if (string.IsNullOrWhiteSpace(email))&#xA;                missingEmailCount++;&#xA;&#xA;            //--------------------------------------------------&#xA;            // Country Count&#xA;            //--------------------------------------------------&#xA;&#xA;            if (!string.IsNullOrWhiteSpace(country))&#xA;            {&#xA;                if (countryCount.ContainsKey(country))&#xA;                    countryCount[country]++;&#xA;                else&#xA;                    countryCount.Add(country, 1);&#xA;            }&#xA;&#xA;        }&#xA;    }&#xA;&#xA;    //==========================&#xA;    // Stop Timer&#xA;    //==========================&#xA;    sw.Stop();&#xA;&#xA;    //==========================&#xA;    // Average Salary&#xA;    //==========================&#xA;&#xA;    double averageSalary = 0;&#xA;&#xA;    if (totalEmployees &gt; 0)&#xA;        averageSalary = totalSalary / totalEmployees;&#xA;&#xA;    //==========================&#xA;    // Prepare Country Report&#xA;    //==========================&#xA;&#xA;    string countryReport = &quot;&quot;;&#xA;&#xA;    foreach (var item in countryCount)&#xA;    {&#xA;        countryReport += item.Key + &quot; : &quot; + item.Value + Environment.NewLine;&#xA;    }&#xA;&#xA;    //==========================&#xA;    // Final Output&#xA;    //==========================&#xA;&#xA;    out_Result =&#xA;        &quot;========== Employee Analytics ==========&quot; + Environment.NewLine +&#xA;        Environment.NewLine +&#xA;        &quot;Total Employees      : &quot; + totalEmployees.ToString(&quot;N0&quot;) + Environment.NewLine +&#xA;        &quot;High Salary (&gt;100K)  : &quot; + highSalaryCount.ToString(&quot;N0&quot;) + Environment.NewLine +&#xA;        &quot;Highest Salary       : &quot; + highestSalary.ToString(&quot;N2&quot;) + Environment.NewLine +&#xA;        &quot;Lowest Salary        : &quot; + lowestSalary.ToString(&quot;N2&quot;) + Environment.NewLine +&#xA;        &quot;Average Salary       : &quot; + averageSalary.ToString(&quot;N2&quot;) + Environment.NewLine +&#xA;        &quot;Duplicate Mobiles    : &quot; + duplicateMobileCount.ToString(&quot;N0&quot;) + Environment.NewLine +&#xA;        &quot;Missing Emails       : &quot; + missingEmailCount.ToString(&quot;N0&quot;) + Environment.NewLine +&#xA;        Environment.NewLine +&#xA;        &quot;----------- Country Wise Count -----------&quot; + Environment.NewLine +&#xA;        countryReport +&#xA;        Environment.NewLine +&#xA;        &quot;Execution Time       : &quot; + sw.Elapsed.ToString();&#xA;}&#xA;catch (Exception ex)&#xA;{&#xA;    out_Result = &quot;Error : &quot; + ex.Message;&#xA;}" DisplayName="Invoke Code" sap:VirtualizedContainerService.HintSize="416,48" sap2010:WorkflowViewState.IdRef="InvokeCode_1" Language="CSharp">
