          <ui:InvokeCode ContinueOnError="{x:Null}" Code="Try&#xA;    Using sourceWorkbook As New ClosedXML.Excel.XLWorkbook(in_SourcePath)&#xA;        Using destWorkbook As New ClosedXML.Excel.XLWorkbook()&#xA;            Dim sourceSheet = sourceWorkbook.Worksheet(1)&#xA;            Dim destSheet = destWorkbook.Worksheets.Add(&quot;Filtered Data&quot;)&#xA;            &#xA;            Dim headers = sourceSheet.Row(1)&#xA;            For colIndex As Integer = 1 To 7&#xA;                destSheet.Cell(1, colIndex).Value = headers.Cell(colIndex).Value&#xA;            Next&#xA;            &#xA;            Dim destRowIndex As Integer = 2&#xA;            &#xA;            For Each row In sourceSheet.RowsUsed()&#xA;                If row.RowNumber() = 1 Then &#xA;                    Continue For&#xA;                End If&#xA;                &#xA;                Dim ageStr As String = row.Cell(4).GetString()&#xA;                Dim countryStr As String = row.Cell(6).GetString()&#xA;                &#xA;                Dim age As Integer = 0&#xA;                If Integer.TryParse(ageStr, age) Then&#xA;                    If age &gt; 30 AndAlso countryStr = &quot;Canada&quot; Then&#xA;                        For colIndex As Integer = 1 To 7&#xA;                            destSheet.Cell(destRowIndex, colIndex).Value = row.Cell(colIndex).Value&#xA;                        Next&#xA;                        destRowIndex = destRowIndex + 1&#xA;                    End If&#xA;                End If&#xA;            Next&#xA;            &#xA;            destWorkbook.SaveAs(in_DestinationPath)&#xA;        End Using&#xA;    End Using&#xA;Catch ex As System.Exception&#xA;    Throw New System.Exception(&quot;Filtering Practice Failed: &quot; &amp; ex.Message)&#xA;End Try" DisplayName="Invoke Code" sap:VirtualizedContainerService.HintSize="416,48" sap2010:WorkflowViewState.IdRef="InvokeCode_4">
